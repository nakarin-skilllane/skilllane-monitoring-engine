# skilllane-monitoring engine: local values (SPEC.md sections 5 and 6).
# The SDK (skilllane-monitoring) and the engine read the same variables.

# Which queue, for both sides: kafka | rabbitmq | bullmq | http | otlp | stdout.
# Left empty on purpose: the first configured connection below wins
# (Kafka brokers, then RabbitMQ URL, then BullMQ Redis URL, then LOG_HTTP_URL,
# then OTEL endpoint).
# scripts/demo.sh sets it per run, e.g. LOG_EXPORT=rabbitmq.
LOG_EXPORT=

# Kafka (external listener of the compose broker)
LOG_KAFKA_BROKERS=localhost:29092
LOG_KAFKA_CLIENT_ID=
LOG_KAFKA_SSL=false
LOG_KAFKA_SASL_MECHANISM=
LOG_KAFKA_SASL_USERNAME=
LOG_KAFKA_SASL_PASSWORD=

# RabbitMQ
LOG_RABBITMQ_URL=amqp://skilllane_monitoring:skilllane_monitoring@localhost:5673/
LOG_RABBITMQ_EXCHANGE=skilllane-monitoring.telemetry

# BullMQ (telemetry Redis, not the app's own Redis on 6391)
LOG_BULLMQ_REDIS_URL=redis://localhost:6390/0
LOG_BULLMQ_PREFIX=bull

# App without a queue (SDK): POST straight to the engine, e.g.
# http://localhost:5100. A queue above wins when both are set. LOG_HTTP_TOKEN
# only when the engine sets ENGINE_INGEST_TOKEN.
LOG_HTTP_URL=
LOG_HTTP_TOKEN=

# Topic / queue names
LOG_TOPIC_LOGS=skilllane-monitoring.logs
LOG_TOPIC_SPANS=skilllane-monitoring.spans

# SDK publisher batching
LOG_EXPORT_BATCH_MS=1000
LOG_EXPORT_BATCH_SIZE=500
LOG_EXPORT_MAX_QUEUE=10000
LOG_EXPORT_MAX_BYTES=800000
LOG_EXPORT_SHUTDOWN_MS=3000

# SDK resource (unchanged from the handoff library)
OTEL_SERVICE_NAME=
APP_ROLE=
OTEL_ENV=local
SERVICE_VERSION=

# Engine: ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=skilllane_monitoring
CLICKHOUSE_PASSWORD=skilllane_monitoring
CLICKHOUSE_READER_USER=skilllane_monitoring_reader
CLICKHOUSE_READER_PASSWORD=skilllane_monitoring_reader
CLICKHOUSE_DATABASE=skilllane_monitoring

# Engine: runtime
ENGINE_ROLE=all
ENGINE_PORT=5100
ENGINE_APPLY_SCHEMA=true
ENGINE_CONSUMER_GROUP=skilllane-monitoring-engine
ENGINE_KAFKA_PARTITIONS=3
ENGINE_CONCURRENCY=50
ENGINE_FLUSH_MS=1000
ENGINE_FLUSH_ROWS=5000
ENGINE_CORS_ORIGIN=*
# HTTP ingest (POST /api/ingest/<stream>) for apps without a queue: on and
# open by default (keep the port internal). ENGINE_INGEST_TOKEN = ask for a
# bearer token (comma-separated to rotate).
ENGINE_INGEST_HTTP=true
ENGINE_INGEST_TOKEN=
ENGINE_INGEST_MAX_BYTES=2000000
ENGINE_INGEST_MAX_INFLIGHT=64

# Monitor sign-in (engine roles api / all). The admin login is exactly these
# two values, checked on every login; unset = nobody can sign in as admin.
SKILLLANE_MONITORING_ADMIN_USERNAME=admin
SKILLLANE_MONITORING_ADMIN_PASSWORD=admin
# Signs sessions; unset = a random key per process (everyone signs in again
# after a restart; set it when running more than one api engine).
SKILLLANE_MONITORING_AUTH_SECRET=
SKILLLANE_MONITORING_SESSION_HOURS=8
# Users and roles live here (default <CLICKHOUSE_DATABASE>_config); the writer
# user needs read/write on it, skilllane_monitoring_reader gets no grant.
CLICKHOUSE_CONFIG_DATABASE=

# Daily report (SPEC.md section 8, "Daily report"): one snapshot
# per env of 09:00 yesterday to 09:00 today (Asia/Bangkok) in the config database.
# REPORT_ENVS: envs built at REPORT_CRON (unset = prod; empty = only the "สร้างรายงาน" button).
# REPORT_ENVS=prod
# REPORT_CRON=0 9 * * *          (Asia/Bangkok; the window stays 09:00 to 09:00)
# REPORT_BAD_ERROR_RATE_X=2
# REPORT_BAD_OUTAGE_MIN=30
# REPORT_BAD_FEATURE_SUCCESS=0.95
# REPORT_WARN_ERROR_RATE_X=1.5
# REPORT_NEW_LOOKBACK_DAYS=14
# REPORT_INCREASE_X=1.5
# REPORT_INCREASE_MIN=10
# REPORT_FEATURE_DROP_PT=0.5
# REPORT_DEPENDENCY_MIN=5
# REPORT_SLOW_X=1.2
# REPORT_SPIKE_X=3
# REPORT_SPIKE_MIN_REQ=50
# Export PNG / PDF: Gotenberg (docker compose up -d gotenberg); unset = export answers 503.
# deploy/docker-compose.yml sets it for the engine container itself.
GOTENBERG_URL=http://localhost:3030

# ---- Deploy (deploy/docker-compose.yml) ------------------------------------------------
# The same file: deploy/.env is a link to this one (ln -s ../.env deploy/.env).
# In the containers compose sets CLICKHOUSE_URL and ENGINE_PORT itself; the SDK
# variables above are not used there. For a deploy change the passwords above to random
# values (openssl rand -hex 24), set ENGINE_INGEST_TOKEN, and empty the dev queues
# above (LOG_KAFKA_BROKERS, LOG_RABBITMQ_URL, LOG_BULLMQ_REDIS_URL) unless the engine
# should read a real one; setup-vm.sh does all of it.

# Image tag of the local build (the git short sha; setup-vm.sh sets it). To run images
# from a registry instead, set the two *_IMAGE names and the tag, then `docker compose pull`.
IMAGE_TAG=local
# ENGINE_IMAGE=ghcr.io/nakarin-skilllane/skilllane-monitoring-engine
# MONITOR_IMAGE=ghcr.io/nakarin-skilllane/skilllane-monitoring-monitor

# Where the monitor (:3300) and the engine (:5100) listen. 127.0.0.1 = this machine only.
# Plain HTTP: put a TLS proxy in front before opening them to a network.
BIND_ADDRESS=127.0.0.1

# Cold storage on S3 (optional; empty URL = off, everything stays on the disk): every hour
# the engine moves log / span parts older than CLICKHOUSE_COLD_AFTER_DAYS to the bucket; they
# stay queryable. A missing bucket or S3 outage only skips the move. Not a backup.
# URL of the S3 service, no bucket and no trailing slash: https://s3.ap-southeast-1.amazonaws.com,
# MinIO http://host.docker.internal:9000. The bucket must exist (nothing creates it).
CLICKHOUSE_S3_URL=
CLICKHOUSE_S3_BUCKET=skilllane-monitoring
CLICKHOUSE_S3_ACCESS_KEY_ID=
CLICKHOUSE_S3_SECRET_ACCESS_KEY=
CLICKHOUSE_S3_REGION=ap-southeast-1
CLICKHOUSE_COLD_AFTER_DAYS=14

# Memory limits. CLICKHOUSE_MEMORY_LIMIT=0 = no container limit: ClickHouse then caps itself at
# 90 % of the machine's RAM. Set a size (6g; 2g on a 4 GB machine) to keep room for other work.
CLICKHOUSE_MEMORY_LIMIT=0
ENGINE_MEMORY_LIMIT=1500m
MONITOR_MEMORY_LIMIT=1g
