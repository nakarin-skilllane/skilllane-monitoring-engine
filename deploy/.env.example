# skilllane-monitoring deploy (deploy/docker-compose.yml). Copy to deploy/.env on the VM;
# setup-vm.sh fills the secrets with random values. Never commit .env.

# Public hostnames become monitor.<DOMAIN> and engine.<DOMAIN>; both A records → the VM.
DOMAIN=example.com

# Image tag of the local build (setup-vm.sh sets the git short sha). To run images from a
# registry instead, set the two *_IMAGE names and the tag, then `docker compose pull`.
IMAGE_TAG=local
# ENGINE_IMAGE=ghcr.io/nakarin-skilllane/skilllane-monitoring-engine
# MONITOR_IMAGE=ghcr.io/nakarin-skilllane/skilllane-monitoring-monitor

# ClickHouse (compose network only). The engine writes as CLICKHOUSE_USER and reads as the reader.
CLICKHOUSE_DATABASE=skilllane_monitoring
CLICKHOUSE_USER=skilllane_monitoring
CLICKHOUSE_PASSWORD=
CLICKHOUSE_READER_USER=skilllane_monitoring_reader
CLICKHOUSE_READER_PASSWORD=

# Monitor sign-in. The admin login is exactly these two values.
SKILLLANE_MONITORING_ADMIN_USERNAME=admin
SKILLLANE_MONITORING_ADMIN_PASSWORD=
# Signs sessions; keep it stable so sign-ins survive restarts.
SKILLLANE_MONITORING_AUTH_SECRET=
SKILLLANE_MONITORING_SESSION_HOURS=8

# HTTP ingest (POST https://engine.<DOMAIN>/api/ingest/<stream>) is public: require this
# bearer token. Apps set LOG_HTTP_URL=https://engine.<DOMAIN> and LOG_HTTP_TOKEN=<this>.
ENGINE_INGEST_HTTP=true
ENGINE_INGEST_TOKEN=
ENGINE_INGEST_MAX_BYTES=2000000
ENGINE_INGEST_MAX_INFLIGHT=64

# Engine runtime
ENGINE_ROLE=all
ENGINE_APPLY_SCHEMA=true
ENGINE_CONSUMER_GROUP=skilllane-monitoring-engine
ENGINE_CONCURRENCY=50
ENGINE_FLUSH_MS=1000
ENGINE_FLUSH_ROWS=5000
# Default https://monitor.<DOMAIN>; set only to override.
# ENGINE_CORS_ORIGIN=

# The customer's queue the engine subscribes to. All empty = HTTP ingest only.
# The queue must be reachable from the VM (allowlist / VPN) and should use TLS + auth.
LOG_EXPORT=
LOG_KAFKA_BROKERS=
LOG_KAFKA_CLIENT_ID=
LOG_KAFKA_SSL=false
LOG_KAFKA_SASL_MECHANISM=
LOG_KAFKA_SASL_USERNAME=
LOG_KAFKA_SASL_PASSWORD=
LOG_RABBITMQ_URL=
LOG_RABBITMQ_EXCHANGE=skilllane-monitoring.telemetry
LOG_BULLMQ_REDIS_URL=
LOG_BULLMQ_PREFIX=bull
LOG_TOPIC_LOGS=skilllane-monitoring.logs
LOG_TOPIC_SPANS=skilllane-monitoring.spans

# Cold storage on S3 (optional; empty = off, everything stays on the VM disk): every hour the engine moves log / span parts older than
# CLICKHOUSE_COLD_AFTER_DAYS from the VM disk to this bucket; they stay queryable. A missing bucket or
# S3 outage only skips the move (parts stay on disk). Any S3-compatible store; the key needs read / write /
# delete on the bucket. Not a backup (DEPLOY.md).
CLICKHOUSE_S3_ENDPOINT=
CLICKHOUSE_S3_ACCESS_KEY_ID=
CLICKHOUSE_S3_SECRET_ACCESS_KEY=
CLICKHOUSE_S3_REGION=ap-southeast-1
CLICKHOUSE_COLD_AFTER_DAYS=14

# Memory limits (12 GB VM defaults; lower on a 4 GB VM: 2g / 1g / 768m).
CLICKHOUSE_MEMORY_LIMIT=6g
ENGINE_MEMORY_LIMIT=1500m
MONITOR_MEMORY_LIMIT=1g
