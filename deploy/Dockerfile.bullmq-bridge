# syntax=docker/dockerfile:1
# skilllane-monitoring BullMQ bridge image. Build context = this repo's root:
#   docker build --platform linux/arm64 -f deploy/Dockerfile.bullmq-bridge .
# The wire contract comes from the npm package skilllane-monitoring (entry skilllane-monitoring/contract).

FROM node:20-bookworm-slim AS build
ENV CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
# Every workspace manifest: --frozen-lockfile checks them all against the lockfile.
COPY apps/bullmq-bridge/package.json apps/bullmq-bridge/
COPY apps/engine/package.json apps/engine/
COPY apps/monitor/package.json apps/monitor/
COPY apps/demo-api/package.json apps/demo-api/
RUN pnpm install --frozen-lockfile --filter @skilllane/monitoring-bullmq-bridge
COPY apps/bullmq-bridge/ apps/bullmq-bridge/
RUN pnpm --filter @skilllane/monitoring-bullmq-bridge build
# `pnpm deploy`: the package plus only its production dependencies, self-contained in /out
# (its own node_modules; not the workspace's virtual store with every app's dev dependencies).
# --legacy: pnpm 10's default deploy wants inject-workspace-packages=true, which only matters for
# workspace-internal dependencies; the apps here depend on npm packages only.
RUN pnpm --filter @skilllane/monitoring-bullmq-bridge deploy --prod --legacy /out \
 && rm -rf /out/src /out/test \
 && test -f /out/dist/main.js \
 && node -e "require.resolve('skilllane-monitoring/contract', { paths: ['/out'] }); require.resolve('bullmq', { paths: ['/out'] })"
# COPY keeps the build host's file modes: under a umask like 007 USER node could not read them.
RUN find /out -path '*/node_modules' -prune -o -exec chmod a+rX {} +

FROM node:20-bookworm-slim
ENV NODE_ENV=production \
    BRIDGE_PORT=5110
WORKDIR /app/apps/bullmq-bridge
COPY --from=build /out/ ./
USER node
EXPOSE 5110
HEALTHCHECK --interval=15s --timeout=10s --start-period=40s --retries=5 \
  CMD node -e "require('http').get('http://127.0.0.1:5110/api/health',r=>process.exit(r.statusCode<400?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/main.js"]
