# syntax=docker/dockerfile:1
# skilllane-monitoring engine image. Build context = this repo's root:
#   docker build --platform linux/arm64 -f deploy/Dockerfile.engine .
# The wire contract comes from the npm package skilllane-monitoring (entry skilllane-monitoring/contract).

FROM node:20-bookworm-slim AS build
ENV CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/engine/package.json apps/engine/
COPY apps/monitor/package.json apps/monitor/
COPY apps/demo-api/package.json apps/demo-api/
RUN pnpm install --frozen-lockfile --filter @skilllane/monitoring-engine
COPY apps/engine/ apps/engine/
RUN pnpm --filter @skilllane/monitoring-engine build \
 && pnpm install --prod --frozen-lockfile --filter @skilllane/monitoring-engine
COPY clickhouse/schema.sql clickhouse/
# COPY keeps the build host's file modes: under a umask like 007 USER node could not read them.
RUN find /app -path '*/node_modules' -prune -o -exec chmod a+rX {} +

FROM node:20-bookworm-slim
ENV NODE_ENV=production \
    ENGINE_PORT=5100 \
    ENGINE_SCHEMA_FILE=/app/clickhouse/schema.sql
WORKDIR /app/apps/engine
COPY --from=build /app/package.json /app/
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/engine/package.json ./
COPY --from=build /app/apps/engine/node_modules ./node_modules
COPY --from=build /app/apps/engine/dist ./dist
COPY --from=build /app/clickhouse/schema.sql /app/clickhouse/schema.sql
USER node
EXPOSE 5100
HEALTHCHECK --interval=15s --timeout=10s --start-period=40s --retries=5 \
  CMD node -e "require('http').get('http://127.0.0.1:5100/api/health',r=>process.exit(r.statusCode<400?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/main.js"]
