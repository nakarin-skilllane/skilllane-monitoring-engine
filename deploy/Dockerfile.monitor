# syntax=docker/dockerfile:1
# skilllane monitor (Next.js) image. Build context = this repo's root:
#   docker build --platform linux/arm64 -f deploy/Dockerfile.monitor .
#
# ENGINE_URL is baked in at build time (next.config.ts rewrites /engine/* → ${ENGINE_URL}/api/*)
# and read again at request time by server code: keep the build arg and the runtime env equal.

FROM node:20-bookworm-slim AS build
ARG ENGINE_URL=http://engine:5100
ENV CI=1 COREPACK_ENABLE_DOWNLOAD_PROMPT=0 NEXT_TELEMETRY_DISABLED=1 ENGINE_URL=$ENGINE_URL
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps/engine/package.json apps/engine/
COPY apps/monitor/package.json apps/monitor/
COPY apps/demo-api/package.json apps/demo-api/
RUN pnpm install --frozen-lockfile --filter @skilllane/monitoring-monitor
COPY apps/monitor/ apps/monitor/
RUN pnpm --filter @skilllane/monitoring-monitor build \
 && pnpm install --prod --frozen-lockfile --filter @skilllane/monitoring-monitor \
 && rm -rf apps/monitor/.next/cache
# COPY keeps the build host's file modes: under a umask like 007 USER node could not read them.
RUN find /app -path '*/node_modules' -prune -o -exec chmod a+rX {} +

FROM node:20-bookworm-slim
ARG ENGINE_URL=http://engine:5100
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 ENGINE_URL=$ENGINE_URL
WORKDIR /app/apps/monitor
COPY --from=build /app/package.json /app/
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/apps/monitor/package.json /app/apps/monitor/next.config.ts ./
COPY --from=build /app/apps/monitor/node_modules ./node_modules
COPY --from=build /app/apps/monitor/public ./public
COPY --from=build --chown=node:node /app/apps/monitor/.next ./.next
USER node
EXPOSE 3300
HEALTHCHECK --interval=15s --timeout=10s --start-period=40s --retries=5 \
  CMD node -e "require('http').get('http://127.0.0.1:3300/login',r=>process.exit(r.statusCode<400?0:1)).on('error',()=>process.exit(1))"
CMD ["./node_modules/.bin/next", "start", "-p", "3300"]
