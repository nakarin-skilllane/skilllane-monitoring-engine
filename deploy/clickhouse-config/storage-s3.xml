<!--
  Cold storage on S3 (any S3-compatible store). Mounted by docker-compose.yml.
  Policy `tiered`: parts are written to the local disk (volume `default`); the engine moves the
  ones older than CLICKHOUSE_COLD_AFTER_DAYS to S3 (volume `cold`) every hour, and ClickHouse
  moves parts earlier when the local disk has less than 10 % free (move_factor).
  The parts' metadata stays on the local disk: S3 alone cannot be read back without it, so
  this is not a backup.
-->
<clickhouse>
  <storage_configuration>
    <disks>
      <s3_cold>
        <type>s3</type>
        <!-- https://<bucket>.s3.<region>.amazonaws.com/<prefix>/ (trailing slash) -->
        <endpoint from_env="CLICKHOUSE_S3_ENDPOINT"/>
        <access_key_id from_env="CLICKHOUSE_S3_ACCESS_KEY_ID"/>
        <secret_access_key from_env="CLICKHOUSE_S3_SECRET_ACCESS_KEY"/>
        <region from_env="CLICKHOUSE_S3_REGION"/>
        <metadata_path>/var/lib/clickhouse/disks/s3_cold/</metadata_path>
        <!-- Start even when the bucket is missing or unreachable: parts then stay on the local disk. -->
        <skip_access_check>true</skip_access_check>
      </s3_cold>
    </disks>
    <policies>
      <tiered>
        <volumes>
          <!-- Named like the volume of the `default` policy: tables created before can switch to it. -->
          <default>
            <disk>default</disk>
          </default>
          <cold>
            <disk>s3_cold</disk>
          </cold>
        </volumes>
        <move_factor>0.1</move_factor>
      </tiered>
    </policies>
  </storage_configuration>
</clickhouse>
